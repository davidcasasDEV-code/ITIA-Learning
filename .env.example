APP_ENV=local
APP_BASE_URL=http://localhost:3000
AWS_REGION=us-east-1

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/itia_learning?schema=public&sslmode=require
RDS_CA_BUNDLE_PATH=

# Cognito
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_APP_CLIENT_ID=example-client-id
COGNITO_APP_CLIENT_SECRET=
COGNITO_DOMAIN=https://example.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_REDIRECT_URI=http://localhost:3000/
# Grupos de Cognito que definen el rol dentro de la app (ver lib/context.js)
COGNITO_ADMIN_GROUP=Admin
COGNITO_TEACHER_GROUP=Teacher

# Sesión e invitaciones (agenda de maestros)
APP_SESSION_COOKIE=itia_session
APP_REFRESH_COOKIE=itia_refresh
INVITATION_TOKEN_SECRET=replace-with-stable-32-plus-character-secret

# S3 (contenido del curso, video de cine, audios: todo privado, sin descarga)
S3_BUCKET=itia-learning-private
S3_KMS_KEY_ID=

# SES
SES_FROM_EMAIL=no-reply@example.com
SES_REPLY_TO_EMAIL=soporte@example.com

# Stripe (Plan Basic $9/mes, Plan Pro $19/mes)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/planes?checkout=cancel

# Observability
OTEL_SERVICE_NAME=itia-learning
